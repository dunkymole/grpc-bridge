{
  "name": "@dunkymole/grpc-bridge",
  "version": "0.1.0",
  "description": "Typed gRPC over HTTP/2 through gRPC Bridge WebSocket tunnels",
  "type": "module",
  "main": "./package-dist/index.js",
  "types": "./package-dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./package-dist/index.d.ts",
      "import": "./package-dist/index.js"
    }
  },
  "files": [
    "package-dist",
    "README.md",
    "LICENSE",
    "licenses"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dunkymole/grpc-bridge.git",
    "directory": "web"
  },
  "homepage": "https://github.com/dunkymole/grpc-bridge#readme",
  "bugs": {
    "url": "https://github.com/dunkymole/grpc-bridge/issues"
  },
  "keywords": [
    "grpc",
    "http2",
    "websocket",
    "browser",
    "streaming",
    "connectrpc"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:package && npm run build:demo",
    "build:package": "node scripts/clean-package.mjs && tsc -p tsconfig.package.json && node scripts/verify-package.mjs",
    "build:demo": "tsc --noEmit && node build.mjs",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "tsx --test test/*.e2e.ts",
    "example": "tsx examples/run.ts",
    "size": "npm run build:package && node scripts/measure-package.mjs",
    "prepack": "npm run build:package"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@debdattabasu/h2ts": "0.1.2"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.15.0",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
