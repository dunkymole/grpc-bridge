{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@dunkymole/grpc-bridge": ["./src/index.ts"],
      "@dunkymole/grpc-bridge/raw": ["./src/raw.ts"],
      "@dunkymole/grpc-bridge/codegen": ["./src/codegen.ts"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "examples/**/*.ts"]
}
